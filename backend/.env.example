# ========================================================
# SHOP.CO E-COMMERCE PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Server & Client
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Comma-separated Vercel/custom frontend origins for production and previews
CORS_ORIGINS=https://sssproduct.vercel.app/
# Set this to the Vercel deployment hostname when using Vercel previews
VERCEL_URL=https://sssproduct.vercel.app/

# 2. MongoDB Database Connection String (MongoDB Atlas M0 or Local)
# Fill your MongoDB connection string here:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sss_ecommerce?retryWrites=true&w=majority

# 3. JWT Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# 4. Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com)
# Enter your Razorpay Key ID and Secret here:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 5. Google Sign-In OAuth 2.0 (Google Cloud Console > Credentials > OAuth Client ID)
# Enter your Google Web Client ID here:
GOOGLE_CLIENT_ID=507230035657-0jsa5s9qmbuk1d8rotqcrqn9aqjic159.apps.googleusercontent.com

# 6. Brevo HTTP Email API for OTP Verification
# Get an API key from Brevo and verify a sender/domain:
BREVO_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=supportdeveloper.sid@gmail.com

# 7. Cloudinary for Seller/Admin Images, Logos and Videos
# Create a Cloudinary app at https://cloudinary.com/
# Copy values from Cloudinary Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=shopco-products
CLOUDINARY_VIDEO_FOLDER=shopco-videos
CLOUDINARY_SELLER_LOGO_FOLDER=shopco-seller-logos
CLOUDINARY_ADMIN_FOLDER=shopco-admin
ADMIN_EMAILS=admin@example.com
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
