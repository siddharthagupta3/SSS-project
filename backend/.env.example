# ========================================================
# SHOP.CO E-COMMERCE PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Server & Client
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. MongoDB Database Connection String (MongoDB Atlas M0 or Local)
# Fill your MongoDB connection string here:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sss_ecommerce?retryWrites=true&w=majority

# 3. JWT Security
JWT_SECRET=production_super_secret_jwt_key_7894561230_sss_shopco
JWT_EXPIRES_IN=7d

# 4. Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com)
# Enter your Razorpay Key ID and Secret here:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 5. Google Sign-In OAuth 2.0 (Google Cloud Console > Credentials > OAuth Client ID)
# Enter your Google Web Client ID here:
GOOGLE_CLIENT_ID=

# 6. Gmail SMTP for Email OTP Verification
# Enter your Gmail and 16-character App Password (https://myaccount.google.com/apppasswords):
EMAIL_USER=
EMAIL_PASS=
